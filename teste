-- Squad hook (deteccao de aliados)
local SquadMembers = {}
local SquadNames = {}

local function refreshSquadNames()
    table.clear(SquadNames)
    for userId, _ in pairs(SquadMembers) do
        local p = Players:GetPlayerByUserId(userId)
        if p then SquadNames[p.Name] = true end
    end
end

local function isAlly(playerModel)
    local uid = playerModel:GetAttribute("UserId")
    if uid and SquadMembers[uid] then return true, SquadMembers[uid] end
    if SquadNames[playerModel.Name] then return true, Config.Squad.AllyColor end
    return false, nil
end

do
    pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local network = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("network", 5)
        if not network then return end
        local SquadState = network:FindFirstChild("SquadState")
        local SquadRequest = network:FindFirstChild("SquadRequest")
        if SquadState and SquadState:IsA("RemoteEvent") then
            SquadState.OnClientEvent:Connect(function(state)
                if typeof(state) ~= "table" then return end
                table.clear(SquadMembers)
                if state.HasSquad and typeof(state.Members) == "table" then
                    local memberColors = nil
                    pcall(function()
                        local cfg = require(ReplicatedStorage.Shared.SquadConfig)
                        memberColors = cfg.MemberColors
                    end)
                    for _, m in ipairs(state.Members) do
                        local color = Config.Squad.AllyColor
                        if memberColors and m.ColorIndex and memberColors[m.ColorIndex] then
                            color = memberColors[m.ColorIndex]
                        end
                        SquadMembers[m.UserId] = color
                    end
                end
                refreshSquadNames()
            end)
        end
        if SquadRequest and SquadRequest:IsA("RemoteEvent") then
            task.delay(1, function()
                pcall(function() SquadRequest:FireServer({Action = "RequestState"}) end)
            end)
        end
    end)
    task.spawn(function()
        while true do refreshSquadNames() task.wait(5) end
    end)
end

-- Death tracking: identifica quem matou o jogador local e cria waypoint no local da morte
-- Baseado no DeathController: LocalPlayer:GetAttribute("DeathFlowState") e "DeathSummaryKiller"
local DeathState = {
    killerName = nil,        -- nome do jogador que matou (ou nil se ambiente)
    deathPosition = nil,     -- Vector3 onde o jogador morreu
    waypointPart = nil,      -- Part do waypoint 3D
    waypointGui = nil,       -- BillboardGui do waypoint
    waypointConn = nil,      -- conexao do loop de atualizacao
}
local KILLER_COLOR = Color3.fromRGB(139, 90, 43)  -- marrom para destaque do assassino

local function isKiller(playerModel)
    if not DeathState.killerName then return false end
    -- Compara por nome (DeathSummaryKiller usa DisplayName ou Name)
    if playerModel.Name == DeathState.killerName then return true end
    -- Tentar comparar com DisplayName do jogador real
    for _, pl in ipairs(Players:GetPlayers()) do
        if (pl.Name == DeathState.killerName or pl.DisplayName == DeathState.killerName)
            and pl.Character == playerModel then
            return true
        end
    end
    return false
end

local function destroyWaypoint()
    if DeathState.waypointConn then DeathState.waypointConn:Disconnect() DeathState.waypointConn = nil end
    if DeathState.waypointGui then DeathState.waypointGui:Destroy() DeathState.waypointGui = nil end
    if DeathState.waypointPart then DeathState.waypointPart:Destroy() DeathState.waypointPart = nil end
end

local function createWaypoint(position)
    destroyWaypoint()
    if not Config.Misc.DeathWaypoint then return end
    local part = Instance.new("Part")
    part.Name = "IL_DeathWaypoint"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Transparency = 1
    part.Size = Vector3.new(1, 1, 1)
    part.Position = position
    part.Parent = workspace

    local gui = Instance.new("BillboardGui")
    gui.Name = "DeathWaypoint"
    gui.AlwaysOnTop = true
    gui.LightInfluence = 0
    -- Tamanho reduzido (um pouco menor que o ESP que usa Size=13 + outline)
    gui.Size = UDim2.fromOffset(140, 50)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    gui.Adornee = part
    gui.Parent = part

    local skull = Instance.new("TextLabel")
    skull.BackgroundTransparency = 1
    skull.Position = UDim2.fromScale(0.5, 0)
    skull.Size = UDim2.fromOffset(22, 22)
    skull.AnchorPoint = Vector2.new(0.5, 0)
    skull.Font = Enum.Font.GothamBold
    skull.Text = "☠"
    skull.TextColor3 = KILLER_COLOR
    skull.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    skull.TextStrokeTransparency = 0.1
    skull.TextScaled = true
    skull.Parent = gui

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.fromScale(0.5, 0.5)
    label.Size = UDim2.fromScale(1, 0.3)
    label.AnchorPoint = Vector2.new(0.5, 0)
    label.Font = Enum.Font.GothamBold
    label.Text = "LOCAL DA MORTE"
    label.TextColor3 = KILLER_COLOR
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0.1
    -- TextSize fixo menor que ESP (ESP=13, waypoint=10)
    label.TextSize = 10
    label.Parent = gui

    local distLabel = Instance.new("TextLabel")
    distLabel.BackgroundTransparency = 1
    distLabel.Position = UDim2.fromScale(0.5, 0.78)
    distLabel.Size = UDim2.fromScale(1, 0.22)
    distLabel.AnchorPoint = Vector2.new(0.5, 0)
    distLabel.Font = Enum.Font.GothamSemibold
    distLabel.Text = ""
    distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distLabel.TextStrokeTransparency = 0.1
    distLabel.TextSize = 10
    distLabel.Parent = gui

    DeathState.waypointPart = part
    DeathState.waypointGui = gui
    DeathState.waypointConn = RunService.RenderStepped:Connect(function()
        if not DeathState.waypointPart or not DeathState.waypointPart.Parent then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local dist = (hrp.Position - position).Magnitude
        local meters = math.max(0, math.floor(dist * StudsToMeters + 0.5))
        distLabel.Text = string.format("%dm", meters)
        -- Some quando chegar perto (< 30 studs)
        if dist < 30 then
            destroyWaypoint()
        end
    end)
end

do
    -- Hook no atributo DeathFlowState do LocalPlayer
    -- As conexoes sao guardadas no DeathState para limpeza no unload
    DeathState.conns = {}
    local function handleDeathFlow()
        local state = LocalPlayer:GetAttribute("DeathFlowState")
        if state == "active" then
            -- Jogador morreu: registrar posicao e killer
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then DeathState.deathPosition = hrp.Position end
            local killer = LocalPlayer:GetAttribute("DeathSummaryKiller")
            if typeof(killer) == "string" and killer ~= "" and killer ~= "THE ENVIRONMENT" then
                DeathState.killerName = killer
            else
                DeathState.killerName = nil
            end
        elseif state == "alive" then
            -- Respawnou: criar waypoint se tiver posicao registrada
            if DeathState.deathPosition then
                task.spawn(function()
                    task.wait(0.5)  -- espera character estabilizar
                    createWaypoint(DeathState.deathPosition)
                end)
            end
        elseif state == "menu" then
            -- Voltou pro menu: limpar tudo
            destroyWaypoint()
            DeathState.killerName = nil
            DeathState.deathPosition = nil
        end
    end
    table.insert(DeathState.conns, LocalPlayer:GetAttributeChangedSignal("DeathFlowState"):Connect(handleDeathFlow))
    -- Tambem ouvir DeathSummaryVersion para pegar o killer atualizado
    table.insert(DeathState.conns, LocalPlayer:GetAttributeChangedSignal("DeathSummaryVersion"):Connect(function()
        local killer = LocalPlayer:GetAttribute("DeathSummaryKiller")
        if typeof(killer) == "string" and killer ~= "" and killer ~= "THE ENVIRONMENT" then
            DeathState.killerName = killer
        end
    end))
end

